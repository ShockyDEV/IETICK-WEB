{
  "name": "ietic27-web",
  "version": "0.1.0",
  "private": true,
  "description": "Web del congreso ieTIC 2027 — XIII Conferencia Ibérica de Innovación en Educación con TIC (IUCE · Universidad de Salamanca)",
  "scripts": {
    "dev": "next dev -p 3027",
    "build": "next build",
    "build:static": "node scripts/build-static.mjs",
    "preview:static": "node scripts/serve-static.mjs",
    "start": "next start -p 3027",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:int": "vitest run --config vitest.int.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "programa:publicar": "tsx scripts/publish-programme.ts",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "next": "^15.5.26",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hot-toast": "^2.6.0",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.6",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
