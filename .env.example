# ─── Base de datos (docker compose levanta PostgreSQL en el puerto 5435) ───
POSTGRES_USER=ietic
POSTGRES_PASSWORD=cambia-esta-contrasena
POSTGRES_DB=ietic27
DATABASE_URL="postgresql://ietic:cambia-esta-contrasena@localhost:5435/ietic27?schema=public"

# ─── Auth.js (panel /backstage) ───
# Generar con: npx auth secret   (o: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true
# URL pública del sitio (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3027

# ─── Cuenta inicial del panel (la crea el seed) ───
ADMIN_EMAIL=admin@ietic27.local
ADMIN_PASSWORD=cambia-esta-contrasena
